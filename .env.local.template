# Supabase Configuration
# Get these from: https://app.supabase.com -> Your Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Separate secret for technician password vault encryption.
# Must be a unique random string with at least 32 characters.
# Do not reuse SUPABASE_SERVICE_ROLE_KEY for this value.
TECH_PASSWORD_VAULT_SECRET=your-32-plus-char-random-secret-here

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n Webhook Secret (generate a random string)
N8N_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=billing@yourdomain.com
