# ==========================================
# Blue Collar Bot SaaS - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# ==========================================
# Supabase Configuration
# ==========================================
# Get these from: https://app.supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
TECH_PASSWORD_VAULT_SECRET=your-32-plus-char-random-secret-here

# ==========================================
# Next.js Configuration
# ==========================================
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# n8n AI Receptionist Integration
# ==========================================
# Generate a secure random string for webhook authentication
# Example: openssl rand -base64 32
N8N_WEBHOOK_SECRET=your-webhook-secret-here-change-in-production

# ==========================================
# Google Maps API
# ==========================================
# Get from: https://console.cloud.google.com/google/maps-apis
# Required for address autocomplete and ETA calculations
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ==========================================
# Email Service (Resend)
# ==========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=billing@yourdomain.com

# ==========================================
# Twilio SMS (Optional)
# ==========================================
# Get from: https://console.twilio.com/
# Leave empty to disable SMS features
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# OpenAI API (AI Features)
# ==========================================
# Get from: https://platform.openai.com/api-keys
# Required for AI features: voice notes, photo analysis, troubleshooting
OPENAI_API_KEY=sk-your-openai-api-key-here

# ==========================================
# Development Tools (Optional)
# ==========================================
# Secret for accessing seed endpoints in development
# Only works when NODE_ENV !== 'production'
SEED_SECRET=dev-only-seed-secret

# ==========================================
# IMPORTANT SECURITY NOTES
# ==========================================
# 1. Copy this file to .env.local and fill in real values
# 2. NEVER commit .env.local to git (.gitignore should exclude it)
# 3. Rotate credentials immediately if accidentally exposed
# 4. Use different credentials for development vs production
# 5. Keep service role keys strictly confidential
# 6. Use Vercel/deployment platform's environment variables UI for production
